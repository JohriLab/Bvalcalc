initialize() {
	//DFE		beta	gamma
	//DFE1	0.9	5
	//DFE2	0.5	50
	//DFE3	0.3	1000
	//DFE4	3		10000	
//	d_gamma_del = 50;
//	d_beta_del = 0.9;
//	defineConstant("d_bin", 0);
//	defineConstant('d_name','test_DFE');
//	defineConstant('d_chr', "2R");
	
	//Variables
	
	defineConstant("bin_size", 200000);
	defineConstant("bin", 0);
	defineConstant("scale", 100);
	defineConstant("Na", asInteger(1e6/scale));
	
	///Set DFE constant	
	defineConstant("t0", 0.0);
	defineConstant("t1", -1.0/(2*Na));
	defineConstant("t2", -10.0/(2*Na));
	defineConstant("t3", -100.0/(2*Na));
	defineConstant("t4", -1.0);
	defineConstant("gamma_pos", 250);
//	defineConstant("gamma_del", asFloat(d_gamma_del)); //Change based on DFE
//	defineConstant("beta_del", asFloat(d_beta_del));
	defineConstant("f_pos", 0);//fraction of beneficial mutations approxima
	defineConstant("f_del", (1.0-f_pos));//fraction of all deleterious classes
	defineConstant("f0", 0.1); //neutral
	defineConstant("f1", 0.2); //weakly del
	defineConstant("f2", 0.3); //mod del
	defineConstant("f3", 0.4); //strong del
	
	///Deleterious DFE
	initializeMutationType("m1", 0.5, "f", 0.0); //CDS coding (mostly synonymous sites), 2Nes = [0,-1]
	initializeMutationType("m2", 0.5, "s", "return runif(1, t2, t1);"); //CDS -1<2Nes<-10, uniform distribution
	initializeMutationType("m3", 0.5, "s", "return runif(1, t3, t2);"); //CDS moderately deleterious, -10<2Nes<-100, uniform distribution
	initializeMutationType("m4", 0.5, "s", "return runif(1, t4, t3);"); //CDS strongly deleterious, 2Nes>=-100, uniform distribution
	initializeMutationType("m5", 0.5, "f", 0.0); //neutral intergenic and intronic, 2Nes = 0
	
//	defineConstant("s_del", gamma_del/(2.0*Na));
//	initializeMutationType("m7", 0.5, "g", -1.0*s_del, beta_del); //Deleterious gamma
		
	///Beneficial Muts
	defineConstant("s_pos", gamma_pos/(2.0*Na));
	initializeMutationType("m6", 0.5, "e", s_pos); //beneficial class
	
	// g1 genomic element type: uses m1 for all mutations
	initializeGenomicElementType("g1", m5, 1.0); //neutral
	initializeGenomicElementType("g2", c(m1, m2, m3, m4, m6), c(f0*f_del, f1*f_del, f2*f_del, f3*f_del, f_pos)); //cds-utr
	
	/// Add genes
	
	Aline = readFile("/work/users/j/i/jimarsh/Bcalc/inputs/200kb_slimtest.txt");
	for (line in Aline){
		Afields = strsplit(line, "\t");
		if(asInteger(Afields[2]) >= bin*bin_size){
			if(asInteger(Afields[1]) < bin*bin_size){
				Afields[1] = bin*bin_size;
			}
			if(asInteger(Afields[2]) > bin*bin_size + bin_size - 1){
				Afields[2] = bin*bin_size + bin_size - 1;
				print(Afields);
				printtype(Afields = Afields);
				break;
			}
			printtype(Afields = Afields);
			print(Afields);
		}
	}
	
	/// Read in rec rate and mut rate and add gene conversion based on rec rate
//	Mline = readFile("/proj/johrilab/projects/DFE_REG/inputs/DmelMutRate/chr"+d_chr+"_mrates.txt"); //From Ks in Supp Table 11 of Mackay et al 2012 with 
	mrate = 3e-9; //asFloat(Mline[bin]) * 1e-9;
//	Rline = readFile("/proj/johrilab/projects/DFE_REG/inputs/DmelRecMap/chr"+d_chr+".rrc"); //From Comeron et al 2012
	rrate = 0.5 * 1e-8; //asFloat(strsplit(Rline[bin + 1], ",")[1]) * 1e-8/2;
//	print("Recombination rate line: " + Rline[bin + 1] + " Mut rate line: " + Mline[bin]);
	
	initializeMutationRate(mrate * scale);
	initializeRecombinationRate((rrate) * scale); //Adding 1e-8 for GC
//	initializeGeneConversion(nonCrossoverFraction = 1-(rrate / (rrate + 1e-8)), meanLength = 440, simpleConversionFraction = 1); //Constant GC rate
}

// create a population of 500 individuals
1 early() {
	sim.addSubpop("p1", Na);
}

100000 early() {
	p1.outputVCFSample(sampleSize = Na, replace = F, outputMultiallelics=F, filePath="/work/users/j/i/jimarsh/Bcalc/vcfs/" + d_name + "_R" + d_repID + ".vcf", append=F, outputNonnucleotides=T);
	
	sim.outputFixedMutations();
	print("N at the end of simulation: " + p1.individualCount);
	print("The last base in the chromosome: " + sim.chromosome.lastPosition + " (" + asInteger(sim.chromosome.lastPosition)/1000000 + "Mb)");
	print("Total nMutations = " + size(sim.mutations));
	print("Theta pi for all mutations = " + (calcHeterozygosity(genomes=p1.genomes)));
	print("Theta pi for m5 mutations = " + (calcHeterozygosity(genomes=p1.genomes, muts=sim.mutationsOfType(m5))));
	print("B for m5 mutations = " + (calcHeterozygosity(genomes=p1.genomes, muts=sim.mutationsOfType(m5)))/0.012);
	print("m5 proportion of all mutations = " + (sim.countOfMutationsOfType(m5)/size(sim.mutations)));
}

//HELPER FUNCTIONS
function (string)printtype(string Afields)
{
	if(Afields[0] == "neu"){
		initializeGenomicElement(g1, asInteger(Afields[1]) - bin*bin_size, asInteger(Afields[2]) - bin*bin_size);
	}
	if(Afields[0] == "cds"){
		initializeGenomicElement(g2, asInteger(Afields[1]) - bin*bin_size, asInteger(Afields[2]) - bin*bin_size);
	}
	return(NULL);
}
