toprint = calcHeterozygosity(genomes=p1.genomes, muts=sim.mutationsOfType(m5), start = 0, end = 9999);
writeFile(c("/work/users/j/i/jimarsh/Bcalc/pi_out/" + d_name + "_R" + d_repID + ".pi"), c("Rep" + d_repID + " pi_starting " + 1 + " : " + toprint) , append = T);


        print("N at the end of simulation: " + p1.individualCount);
